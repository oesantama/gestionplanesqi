# ==============================================================================
# PROXY REVERSO PARA CPANEL LITESPEED / APACHE A DOCKER
# Redirige todo el tráfico a Nginx Frontend (Puerto 8060) que gestiona la app y la API
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redireccionar todo el tráfico al contenedor Nginx Docker (Puerto 8060)
  RewriteRule ^(.*)$ http://127.0.0.1:8060/$1 [P,L]
</IfModule>
