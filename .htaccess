# ==============================================================================
# PROXY REVERSO PARA CPANEL LITESPEED / APACHE A DOCKER
# Permite abrir http://gestion.qinspecting.com directamente sin puertos
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redireccionar peticiones API al contenedor Node (Puerto 3060)
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^api/(.*)$ http://localhost:3060/api/$1 [P,L]

  # 2. Redireccionar peticiones Frontend al contenedor Nginx Docker (Puerto 8060)
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule ^(.*)$ http://localhost:8060/$1 [P,L]
</IfModule>
