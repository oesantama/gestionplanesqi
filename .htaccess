# ==============================================================================
# REVERSE PROXY Y ENRUTAMIENTO PARA DOCKER EN CPANEL (sin mostrar puertos)
# Redirige http://gestion.qinspecting.com directamente a los contenedores Docker
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirigir peticiones de API al contenedor backend (puerto 3060)
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ http://127.0.0.1:3060/api/$1 [P,L]

  # 2. Redirigir peticiones del Frontend al contenedor Nginx Docker (puerto 8060)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:8060/$1 [P,L]
</IfModule>
