# Dependencias (cada proyecto -- frontend/, api/, src-electron/, src-capacitor/
# -- trae node_modules propio, este patrón sin "/" aplica a cualquier nivel)
node_modules

# Variables de entorno / secretos -- nunca se sube ningún .env real
.env
.env.local
.env.*.local

# Paquetes generados por scripts/build-api.sh (qinspecting_api) o similares
deploy-out

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
.DS_Store
Thumbs.db
.thumbs.db

# Editores / IDEs -- se ignoran las carpetas de config de cada editor
# EXCEPTO frontend/.vscode, que Quasar deja con extensiones/ajustes
# recomendados a propósito para el proyecto (esa sí se versiona).
.idea
*.swp
*.swo
